# Copia este archivo a .env y completa los valores.

ENVIRONMENT=development

# LangSmith (tracing/observabilidad de LangChain)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=SemanticProductSearch

# LLM
ANTHROPIC_API_KEY=

# Base de datos (Postgres + pgvector en producción/desarrollo)
DATABASE_URL=sqlite:///./semantic_product_search.db

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
